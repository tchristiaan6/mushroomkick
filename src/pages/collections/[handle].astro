---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { collections, collectionProducts } from '../../lib/data';
export function getStaticPaths() { return [{ params: { handle: 'all' } }, ...Object.keys(collections).map(h => ({ params: { handle: h } }))]; }
const { handle } = Astro.params;
const col = handle === 'all' ? { title: 'Shop All', description: 'Every product Mushroom Kick sold: functional mushroom coffee, capsules, gummies, powders and mugs.' } : collections[handle!];
const items = collectionProducts(handle!);
---
<Base title={col.title} description={col.description || `${col.title} from Mushroom Kick.`}>
<section class="section"><div class="container">
  <p class="kicker">Collection</p><h1>{col.title}</h1>
  {col.description && <p style="max-width:640px;color:#3a3a3a">{col.description}</p>}
  <div class="grid grid--3" style="margin-top:32px">{items.map((p: any) => <ProductCard p={p} />)}</div>
</div></section>
</Base>
