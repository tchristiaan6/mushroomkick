---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products, money, productCollections, collectionProducts, site } from '../../lib/data';
export function getStaticPaths() { return products.map(p => ({ params: { handle: p.handle }, props: { p } })); }
const { p } = Astro.props;
const related = [...new Set(productCollections(p.handle).flatMap(c => collectionProducts(c)))].filter((x: any) => x.handle !== p.handle).slice(0, 3);
const desc = p.body.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 160);
---
<Base title={p.title} description={desc} image={p.images[0]?.src} type="product">
<section class="section"><div class="container product">
  <div class="gallery">
    <img id="main" src={p.images[0]?.src} alt={p.images[0]?.alt} width="1000" height="1000">
    {p.images.length > 1 && <div class="thumbs">{p.images.map((im: any, i: number) => <button type="button" class:list={['thumb', { on: i === 0 }]} data-src={im.src} aria-label={`Image ${i + 1}`}><img src={im.src} alt="" loading="lazy" width="120" height="120"></button>)}</div>}
  </div>
  <div class="info">
    <p class="kicker">{p.type || 'Mushroom Kick'}</p>
    <h1 style="font-size:clamp(28px,3.4vw,40px)">{p.title}</h1>
    <p class="price">{p.compare && Number(p.compare) > Number(p.price) ? <><s style="color:var(--muted);font-weight:400">{money(p.compare)}</s> </> : null}{money(p.price)}</p>
    {p.variants.length > 0 && <div class="variants"><span class="kicker" style="margin:0 0 6px">{p.options[0]}</span><div class="pills">{p.variants.map((v: any) => <span class="pill">{v.option} · {money(v.price)}</span>)}</div></div>}
    <div class="actions"><span class="btn btn--disabled">No longer available</span></div>
    <p class="note">Mushroom Kick closed in 2025. Product pages are kept for reference.</p>
    <div class="rte" set:html={p.body} />
    <div class="mini-badges">{site.badges.slice(0, 6).map((b: any) => <span><img src={b.icon} alt="" width="28" height="28" loading="lazy">{b.label}</span>)}</div>
  </div>
</div></section>
{related.length > 0 && <section class="section section--soft"><div class="container"><h2 style="font-size:26px;margin-bottom:20px">You may also like</h2><div class="grid grid--3">{related.map((r: any) => <ProductCard p={r} />)}</div></div></section>}
</Base>
<style>
.product{display:grid;grid-template-columns:1.1fr 1fr;gap:48px;align-items:start}@media(max-width:860px){.product{grid-template-columns:1fr}}
.gallery{position:sticky;top:96px}#main{border:1px solid var(--border-soft);border-radius:var(--radius);width:100%}
.thumbs{display:flex;gap:10px;margin-top:12px;flex-wrap:wrap}.thumb{padding:0;border:1px solid var(--border-soft);border-radius:8px;overflow:hidden;background:#fff;cursor:pointer;width:72px;height:72px}.thumb img{width:100%;height:100%;object-fit:cover}.thumb.on{border-color:var(--ink)}
.price{font-size:24px;font-weight:500;margin:0 0 16px}.pills{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px}.pill{border:1px solid var(--border);border-radius:999px;padding:6px 12px;font-size:13px}
.actions{margin:8px 0 6px}.note{font-size:13px;color:var(--muted);margin-bottom:22px}
.info .rte{font-size:15px}.mini-badges{display:flex;flex-wrap:wrap;gap:14px 20px;margin-top:24px;padding-top:20px;border-top:1px solid var(--border-soft);font-size:12.5px;font-weight:500}.mini-badges span{display:inline-flex;align-items:center;gap:8px}
</style>
<script>
  const main = document.getElementById('main') as HTMLImageElement | null;
  document.querySelectorAll<HTMLButtonElement>('.thumb').forEach(b => b.addEventListener('click', () => { if (main) main.src = b.dataset.src!; document.querySelectorAll('.thumb').forEach(x => x.classList.toggle('on', x === b)); }));
</script>
