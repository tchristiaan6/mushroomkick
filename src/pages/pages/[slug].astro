---
import Base from '../../layouts/Base.astro';
import { pages } from '../../lib/data';
const map: Record<string, string> = { 'about-us': 'about', 'contact': 'contact', 'data-sharing-opt-out': 'privacy-choices' };
export function getStaticPaths() { return ['about-us', 'contact', 'data-sharing-opt-out'].map(s => ({ params: { slug: s } })); }
const page = pages.find(p => p.slug === map[Astro.params.slug!]);
---
<Base title={page.title}>
<section class="section"><div class="container"><h1>{page.title}</h1><div class="rte" set:html={page.html} />{page.slug === 'contact' && <p style="color:var(--muted);font-size:14px;margin-top:24px">The store is closed. For anything about this archive, reach Tom through <a href="https://tchristiaan.com">tchristiaan.com</a>.</p>}</div></section>
</Base>
