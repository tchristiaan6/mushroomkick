---
import '../styles/global.css';
import { nav } from '../lib/data';
const { title, description = 'Functional mushroom coffee and supplements from Denver, Colorado.', image = '/images/site/hero-241da2.jpg', type = 'website' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title ? `${title} | Mushroom Kick` : 'Mushroom Kick | Functional Mushroom Coffee and Supplements'}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link rel="icon" href="/mark.png" type="image/png">
<meta property="og:type" content={type}><meta property="og:site_name" content="Mushroom Kick"><meta property="og:title" content={title || 'Mushroom Kick'}><meta property="og:description" content={description}><meta property="og:image" content={new URL(image, Astro.site)}><meta property="og:url" content={canonical}>
<meta name="twitter:card" content="summary_large_image">
<meta name="robots" content="index,follow">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700;1,9..40,400&display=swap" rel="stylesheet">
</head>
<body>
<div class="archive-bar">Mushroom Kick closed in 2025. This is an archived version of the store; nothing here is for sale. A <a href="https://tchristiaan.com" target="_blank" rel="noopener">TChristiaan</a> project by Thomas Bouwman.</div>
<header class="header"><div class="container">
  <a class="brand" href="/"><img src="/mark.png" alt="" width="30" height="30">Mushroom Kick</a>
  <nav class="nav" aria-label="Main">{nav.map(n => <a href={n.href} aria-current={path === n.href || (n.href !== '/' && path.startsWith(n.href)) ? 'page' : undefined}>{n.label}</a>)}</nav>
  <div class="header__aside">Denver, Colorado<br>Free US shipping · 30-day refunds</div>
</div></header>
<main><slot /></main>
<footer class="footer"><div class="container">
  <div class="cols">
    <div><h4>Mushroom Kick</h4><p>Functional mushroom coffee and supplements.</p></div>
    <div><h4>Quick Links</h4><a href="/pages/about-us">About</a><a href="/pages/contact">Contact</a><a href="/blogs/mushroom-wellness">Blog</a><a href="/collections/all">Shop All</a></div>
    <div><h4>Policies</h4><a href="/policies/refund-policy">Refund Policy</a><a href="/policies/shipping-policy">Shipping Policy</a><a href="/policies/privacy-policy">Privacy Policy</a><a href="/pages/data-sharing-opt-out">Your Privacy Choices</a></div>
    <div><h4>Main Store</h4><p>1880 Little Raven St<br>Denver, CO 80202</p></div>
  </div>
  <div class="bottom"><span>© 2025 Mushroom Kick LLC. Archived 2026.</span><span>A <a href="https://tchristiaan.com" style="display:inline;color:var(--accent)">TChristiaan</a> project by Thomas Bouwman</span></div>
</div></footer>
<script>
  const els=[...document.querySelectorAll('.reveal')];
  if(!matchMedia('(prefers-reduced-motion: reduce)').matches){const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{rootMargin:'0px 0px -8% 0px'});els.forEach(e=>e.getBoundingClientRect().top<innerHeight?e.classList.add('in'):io.observe(e))}else els.forEach(e=>e.classList.add('in'));
</script>
</body>
</html>
